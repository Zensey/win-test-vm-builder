<?xml version="1.0" encoding="utf-8"?>
<!--
  Unattended install answer file for the drivertest test VM (Windows 10 x64).
  Produces a guest matching tests/vbox_autotest.py's prerequisites: a local
  administrator with a non-empty password, UAC off, and WinRM reachable so
  Packer can run the provisioning scripts.

  Username/password here MUST match winrm_username/winrm_password in
  packer/win10/win10-testvm.pkr.hcl.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>Primary</Type>
              <Size>350</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Format>NTFS</Format>
              <Label>System Reserved</Label>
              <Active>true</Active>
              <TypeID>0x27</TypeID>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>2</PartitionID>
              <Format>NTFS</Format>
              <Label>Windows</Label>
              <Letter>C</Letter>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
        <WillShowUI>OnError</WillShowUI>
      </DiskConfiguration>
      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 10 Pro</Value>
            </MetaData>
          </InstallFrom>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>2</PartitionID>
          </InstallTo>
          <WillShowUI>OnError</WillShowUI>
        </OSImage>
      </ImageInstall>
      <UserData>
        <AcceptEula>true</AcceptEula>
        <!-- Generic, non-activating KMS client setup key for Windows 10 Pro
             (public, documented by Microsoft for exactly this purpose): the
             install.wim on a standard retail/consumer ISO holds several
             editions, and Setup can't pick one unattended without a key. -->
        <ProductKey>
          <Key>W269N-WFGWX-YVC9B-4J6C9-T83GX</Key>
          <WillShowUI>Never</WillShowUI>
        </ProductKey>
      </UserData>
    </component>
  </settings>

  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <ComputerName>testvm</ComputerName>
      <TimeZone>UTC</TimeZone>
    </component>
    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <RunSynchronous>
        <!-- Turn UAC off now so the Packer winrm/guest-control communicator gets an
             elevated token for the local administrator right away. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v EnableLUA /t REG_DWORD /d 0 /f</Path>
        </RunSynchronousCommand>
        <!-- Bring up WinRM over HTTP entirely through its Group Policy
             registry keys, not "winrm quickconfig"/Set-Item WSMan: (the
             previous approach here) - both refuse to enable
             AllowUnencrypted while the network is classified "Public",
             which is exactly how VirtualBox's NAT adapter comes up. That
             previous approach reclassified the network to Private in
             FirstLogonCommands first (via Get-NetConnectionProfile) to work
             around it, which is timing-sensitive: it depends on NLA having
             already (not yet) classified the network at the moment that
             command runs, a race that went from "usually fine" to
             reliably losing once headless = true made boot/OOBE slower and
             moved where in that race the command landed - confirmed live,
             AllowUnencrypted/Basic stayed false for the whole build even
             though the network showed Private by the time anyone checked.
             The Group Policy keys below sidestep the problem entirely, the
             same fix win7/http/Autounattend.xml uses: honored regardless of
             network category, no reclassification, no race. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WinRM\Service" /v AllowAutoConfig /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WinRM\Service" /v IPv4Filter /t REG_SZ /d "*" /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WinRM\Service" /v AllowUnencryptedTraffic /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WinRM\Service\Auth" /v Basic /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>6</Order>
          <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WinRM\Client" /v AllowUnencryptedTraffic /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>7</Order>
          <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WinRM\Client" /v TrustedHostsList /t REG_SZ /d "*" /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>8</Order>
          <Path>reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\WinRM\Client\Auth" /v Basic /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>9</Order>
          <Path>netsh advfirewall firewall add rule name=WinRM-HTTP dir=in action=allow protocol=TCP localport=5985 profile=any</Path>
        </RunSynchronousCommand>
        <!-- "exit 0" at the end: a fresh install's winrm service is Manual
             start, so it needs starting here - but RunSynchronousCommand
             aborts the whole specialize pass on a non-zero exit code, and
             "net start" on a service that happens to already be running
             returns one too. The rest of the WinRM setup (creating the
             actual listener, enabling Basic auth, raising the shell quota)
             is in FirstLogonCommands below, not here - see its comment for
             why (confirmed live: these silently no-op from specialize's
             SYSTEM/Session 0 context, same as win7). -->
        <RunSynchronousCommand wcm:action="add">
          <Order>10</Order>
          <Path>cmd /c "sc config winrm start= auto &amp; net start winrm &amp; exit 0"</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <UserAccounts>
        <AdministratorPassword>
          <Value>DriverTestTest!1</Value>
          <PlainText>true</PlainText>
        </AdministratorPassword>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>tester</Name>
            <Group>Administrators</Group>
            <Password>
              <Value>DriverTestTest!1</Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>
      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>tester</Username>
        <Password>
          <Value>DriverTestTest!1</Value>
          <PlainText>true</PlainText>
        </Password>
        <LogonCount>999</LogonCount>
      </AutoLogon>
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipMachineOOBE>true</SkipMachineOOBE>
        <SkipUserOOBE>true</SkipUserOOBE>
      </OOBE>
      <FirstLogonCommands>
        <!-- Finishes the WinRM setup that specialize's GPO registry keys
             (AllowUnencrypted via policy - the one setting actually guarded
             by network category) couldn't do on their own: creating the
             actual HTTP listener and raising the WinRM shell quota turned
             out (confirmed live, same as win7) to silently no-op from
             specialize's SYSTEM/Session 0 context - the service comes up
             RUNNING with no listener and the default MaxShellsPerUser=5
             regardless of these commands being present there and exiting 0.
             `winrm.cmd` apparently needs a real logged-on user context for
             these, not specialize's. -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>cmd /c "winrm create winrm/config/Listener?Address=*+Transport=HTTP &amp; exit 0"</CommandLine>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <CommandLine>cmd /c winrm set winrm/config/service/auth @{Basic="true"}</CommandLine>
        </SynchronousCommand>
        <!-- Default MaxShellsPerUser is 5. Packer's WinRM waiter opens a new
             shell on every health-check poll; if several polls land before
             this listener exists, the failed/abandoned shells count against
             this quota and it's easy to exhaust it before the connection
             ever succeeds (same "QuotaLimit" failure mode win7 hit). -->
        <SynchronousCommand wcm:action="add">
          <Order>3</Order>
          <CommandLine>cmd /c winrm set winrm/config/winrs @{MaxShellsPerUser="50"}</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
